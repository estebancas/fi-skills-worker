# Copy to .env (gitignored) for running the worker by hand:
#
#     set -a; . ./.env; set +a
#     .venv/bin/python3 worker.py --check
#
# This file is a convenience for manual runs ONLY. Nothing reads .env
# automatically — Python has no built-in dotenv support, and the worker
# deliberately has no third-party dependency to add it.
#
# In production launchd supplies these from the EnvironmentVariables block in
# com.hermes.worker.plist, which is the real config. If you change a value
# here, change it there too — they do not share a source.

# ---- queue ----------------------------------------------------------------
QUEUE_URL=http://REPLACE_ME:8080
QUEUE_TOKEN=REPLACE_ME
QUEUE_AUTH_HEADER=Authorization
QUEUE_AUTH_SCHEME=Bearer

# ---- worker ---------------------------------------------------------------
WORKER_NAME=mac
POLL_WAIT=30
HEARTBEAT_INTERVAL=30
JOB_TIMEOUT=1800
PUBLISH_MANIFEST=auto

# Vault index pushed to the queue so Fi can search it while the Mac sleeps.
# Metadata and summaries only — transcripts never leave this machine.
PUBLISH_CATALOG=auto
CATALOG_RECONCILE_S=3600

# ---- skills ---------------------------------------------------------------
VAULT_DIR=$HOME/vault
WHISPER_MODEL=$HOME/models/ggml-base.en.bin

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:latest
OLLAMA_NUM_CTX=32768
OLLAMA_KEEP_ALIVE=30m

# yt-dlp cookies. Under launchd, --cookies-from-browser usually fails (it needs
# a Keychain unlock), surfacing as a YouTube bot-check error. Export a
# cookies.txt and set COOKIES_FILE instead if that happens.
COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=

# Optional push notification on permanent failures.
NTFY_TOPIC=
